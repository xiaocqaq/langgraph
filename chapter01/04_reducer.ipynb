   "source": [
    "# left: 从最开始的位置合并到当前节点的位置的值\n",
    "# right: 当前节点的值\n",
    "# 返回值: 合并后的值\n",
    "def my_reducer(left: list[str],right: list[str]) -> list[str]:\n",
    "    return left + [\"node_3333 运行完毕\"]\n",
    "# 1. node1 运行之后的值\n",
    "left = [\"start\",\"node_1 运行完毕\"]\n",
    "right = [\"node_2 运行完毕\"]\n",
    "# 2. 合并\n",
    "merged = my_reducer(left,right)\n",
    "print(merged)"
   ],
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['start', 'node_1 运行完毕', 'node_3333 运行完毕']\n"
     ]
    }
   ],
